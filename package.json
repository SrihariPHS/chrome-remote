{
  "name": "chrome-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A warm remote Chromium you drive with one intent per call, and watch from any device.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "agent-bench": "node bench/agent-meter.mjs",
    "console": "node server.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "ws": "8.18.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "browser",
    "computer-use",
    "chromium",
    "playwright",
    "mcp",
    "agent",
    "remote-desktop",
    "screencast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SrihariPHS/chrome-remote.git"
  },
  "homepage": "https://chrome.inkwork.studio",
  "bugs": {
    "url": "https://github.com/SrihariPHS/chrome-remote/issues"
  }
}
