{
  "name": "chrome-inkwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "chrome.inkwork.studio \u2014 a remote Chromium you drive with one JS intent at a time.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "agent-bench": "node bench/agent-meter.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "ws": "8.18.3"
  },
  "engines": {
    "node": ">=22"
  }
}
