# cp secrets.env.example secrets.env && chmod 600 secrets.env
# Generate a long token — anyone with it controls the browser.
IW_TOKEN=replace-with-output-of-openssl-rand-base64-48
IW_MAX_SESSIONS=4
# Optional: allow your own console origin to make cross-origin API calls.
# IW_ORIGIN=https://chrome.inkwork.studio

# Simple PIN for the human console (agents use IW_TOKEN above).
# Set a long random value if this host is shared.
IW_PIN=787878
