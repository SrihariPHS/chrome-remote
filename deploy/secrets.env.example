# cp secrets.env.example secrets.env && chmod 600 secrets.env
# Generate a long token — anyone with it controls the browser.
IW_TOKEN=replace-with-output-of-openssl-rand-base64-48
IW_MAX_SESSIONS=4
IW_SESSION_TTL_MIN=20

# Six digits, so a phone can sign in without pasting the token.
IW_PIN=123456

# Optional: extra origins allowed to call the API cross-origin.
# IW_ORIGIN=https://chrome.example.com
